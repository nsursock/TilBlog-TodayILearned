# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable and secret API keys tab → publishable key (sb_publishable_...)
# Legacy "anon" key still works if you prefer SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Statsman analytics (baked in at Eleventy build). Empty SITE_ID disables.
# Defaults in src/_data/env.js already point at production Railway + this site.
# Local Statsman override:
# STATSMAN_SCRIPT_URL=http://localhost:5173/tracker.js
# STATSMAN_SITE_ID=
STATSMAN_SCRIPT_URL=
STATSMAN_SITE_ID=
