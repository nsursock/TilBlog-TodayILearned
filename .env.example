# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable and secret API keys tab → publishable key (sb_publishable_...)
# Legacy "anon" key still works if you prefer SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Statsman analytics (optional). Leave SITE_ID empty to disable the tracker.
# Local self-host / dev:
STATSMAN_SCRIPT_URL=http://localhost:5173/tracker.js
STATSMAN_SITE_ID=882d4e8771855b1b
# Production cloud dogfood:
# STATSMAN_SCRIPT_URL=https://YOUR_CLOUD/tracker.js
# STATSMAN_SITE_ID=f7b1b85574d456b9
