# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable and secret API keys tab → publishable key (sb_publishable_...)
# Legacy "anon" key still works if you prefer SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Statsman analytics (baked in at Eleventy build). Empty SITE_ID uses the Founder-cloud default in env.js.
# STATSMAN_SCRIPT_URL=https://statsman-production.up.railway.app/tracker.js
# STATSMAN_SITE_ID=b58bef437d0aabfd
# Local Statsman override:
# STATSMAN_SCRIPT_URL=http://localhost:5173/tracker.js
# STATSMAN_SITE_ID=
STATSMAN_SCRIPT_URL=
STATSMAN_SITE_ID=
