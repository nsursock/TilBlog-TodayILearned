---
layout: layouts/base.njk
comments: true
katex: true
---

<article class="reveal" data-til-lesson data-til-track="{{ track }}" data-til-level="{{ level }}">
  <header class="mb-12 border-b border-line/80 pb-10">
    <p class="track-kicker">{{ track }} · {{ level }}</p>
    <h1
      class="mt-4 max-w-3xl font-display text-4xl font-extrabold tracking-tight text-ink md:text-6xl md:leading-[1.05]"
    >
      {{ title }}
    </h1>
    {% if takeaway %}
    <p
      class="mt-6 max-w-2xl border-l-2 border-signal pl-5 font-display text-xl font-medium text-ink md:text-2xl"
    >
      {{ takeaway }}
    </p>
    {% endif %}
    <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    </p>
  </header>

  <div class="prose-til">
    {{ content | safe }}
  </div>

  {% set nav = collections.posts | trackNav(page.url, track) %}
  <nav
    class="mt-16 grid gap-8 border-t border-line/80 pt-8 sm:grid-cols-2"
    aria-label="Lesson navigation"
  >
    <div>
      {% if nav.prev %}
      <a class="group block max-w-sm" href="{{ nav.prev.url }}" data-til-event="lesson_nav" data-til-label="prev" data-til-track="{{ nav.prev.data.track }}" data-til-level="{{ nav.prev.data.level }}">
        <span class="btn-ghost">← Previous</span>
        <span
          class="mt-2 block font-display text-lg font-bold tracking-tight text-ink transition group-hover:text-signal-deep"
        >
          {{ nav.prev.data.level }} · {{ nav.prev.data.title }}
        </span>
      </a>
      {% endif %}
    </div>
    <div class="sm:text-right">
      {% if nav.next %}
      <a class="group block max-w-sm sm:ml-auto" href="{{ nav.next.url }}" data-til-event="lesson_nav" data-til-label="next" data-til-track="{{ nav.next.data.track }}" data-til-level="{{ nav.next.data.level }}">
        <span class="btn-ghost sm:justify-end">Next →</span>
        <span
          class="mt-2 block font-display text-lg font-bold tracking-tight text-ink transition group-hover:text-signal-deep"
        >
          {{ nav.next.data.level }} · {{ nav.next.data.title }}
        </span>
      </a>
      {% endif %}
    </div>
  </nav>
</article>

<section
  class="reveal mt-20 border-t border-line/80 pt-12"
  aria-labelledby="comments-heading"
  x-data='comments({{ page.url | dump | safe }})'
  x-cloak
>
  <h2
    id="comments-heading"
    class="font-display text-2xl font-bold tracking-tight text-ink md:text-3xl"
  >
    Comments
  </h2>
  <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft">
    Guest notes · moderated before they appear
  </p>

  <template x-if="unavailable">
    <p class="mt-8 text-sm text-ink-soft">Comments are not configured for this build.</p>
  </template>

  <template x-if="!unavailable">
    <div class="mt-10 space-y-10">
      <div>
        <p
          class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft"
          x-show="loading"
        >
          Loading…
        </p>
        <p
          class="text-sm text-ink-soft"
          x-show="!loading && comments.length === 0"
          x-cloak
        >
          No comments yet. Be the first.
        </p>
        <ul class="space-y-8" x-show="!loading && comments.length" x-cloak>
          <template x-for="comment in comments" :key="comment.id">
            <li class="border-l-2 border-signal/40 pl-5">
              <p class="font-display text-base font-semibold text-ink" x-text="comment.author_name"></p>
              <p
                class="mt-1 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-soft"
                x-text="formatDate(comment.created_at)"
              ></p>
              <p class="mt-3 whitespace-pre-wrap text-ink-soft" x-text="comment.body"></p>
            </li>
          </template>
        </ul>
      </div>

      <form class="relative space-y-5" @submit.prevent="submit" x-show="!submitted">
        <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" x-model="website" />
          </label>
        </div>
        <div>
          <label
            for="comment-name"
            class="block font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft"
            >Name</label
          >
          <input
            id="comment-name"
            type="text"
            name="name"
            required
            maxlength="80"
            autocomplete="name"
            class="mt-2 w-full border border-line bg-foam/70 px-4 py-3 font-sans text-ink outline-none transition focus:border-signal"
            x-model="authorName"
          />
        </div>
        <div>
          <label
            for="comment-body"
            class="block font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft"
            >Comment</label
          >
          <textarea
            id="comment-body"
            name="body"
            required
            maxlength="2000"
            rows="5"
            class="mt-2 w-full border border-line bg-foam/70 px-4 py-3 font-sans text-ink outline-none transition focus:border-signal"
            x-model="body"
          ></textarea>
        </div>
        <p class="text-sm text-signal-deep" x-show="error" x-text="error" x-cloak></p>
        <button type="submit" class="btn-signal" :disabled="submitting">
          <span x-text="submitting ? 'Sending…' : 'Send comment'"></span>
        </button>
      </form>

      <p
        class="border-l-2 border-signal pl-5 font-display text-lg font-medium text-ink"
        x-show="submitted"
        x-cloak
      >
        Thanks — your note is pending review.
      </p>
    </div>
  </template>
</section>
